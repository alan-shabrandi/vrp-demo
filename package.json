    "@types/react-dom": "^19",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
